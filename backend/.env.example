APP_NAME=CourtQ
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Tokyo
APP_FRONTEND_URL=http://localhost:5173

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=courtq_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=ap4

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Congestion / Stock（config/courtq.php） ---
# 最終更新からこの分数を超えたら「情報が古い可能性があります」を表示する
COURTQ_STALE_AFTER_MINUTES=15
# 一覧 API のサーバーキャッシュ秒数（10〜30。更新時に破棄される。CACHE_DRIVER=database のため cache テーブルを使う）
COURTQ_LIST_CACHE_SECONDS=20
# スタッフ招待コードの有効日数
COURTQ_INVITATION_TTL_DAYS=7

# --- Demo seed（php artisan db:seed。本番の公開デモでは SEED_DEMO=true）---
# デモアカウントのパスワード。公開デモでは誰でも知る前提の値。変える場合は設定する
# DEMO_PASSWORD=

# --- Production only (Railway). 詳細は docs/deployment.md ---
# CORS_ALLOWED_ORIGINS=https://<vercel-domain>
# CORS_ALLOWED_ORIGINS_PATTERNS=
# SANCTUM_STATEFUL_DOMAINS=<vercel-domain>

# --- Realtime (Pusher Channels) ---
# ローカル開発は BROADCAST_DRIVER=log のままでキー不要（イベントはログに出力される）。
# 本番は BROADCAST_DRIVER=pusher にして、上の PUSHER_APP_ID / PUSHER_APP_KEY / PUSHER_APP_SECRET /
# PUSHER_APP_CLUSTER（Pusher ダッシュボードの App Keys の値）を設定する。詳細は docs/deployment.md
